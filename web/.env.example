# 케어브릿지 web 환경 변수 예시
# 쓰는 법: 이 파일을 .env.local 로 복사해 값을 채운다. .env.local 은 커밋되지 않는다(.gitignore).
# 진짜 키는 이 파일, 채팅, 문서, 커밋 어디에도 붙이지 않는다.
# NEXT_PUBLIC_ 이 붙은 값만 브라우저로 나간다. 키에는 절대 붙이지 않는다.

# ── Mock 모드 ─────────────────────────────────────────────
# true(또는 비움): Claude·받아쓰기를 부르지 않고 가짜 응답. 화면 위에 MOCK 표시.
# false: 실제 호출. Vercel Production은 반드시 false.
USE_MOCK_AI=true

# ── Claude: 코디세이 공개 API (Anthropic 규격) ───────────────
# 키는 ANTHROPIC_API_KEY 가 아니라 ANTHROPIC_AUTH_TOKEN (Bearer 헤더로 나감. x-api-key는 401)
ANTHROPIC_BASE_URL=https://copa.codyssey.kr
ANTHROPIC_AUTH_TOKEN=
# 로컬 개발은 Haiku로 아낀다. 배포(Production)는 AI_MODEL_MAIN=claude-sonnet-4
AI_MODEL_MAIN=claude-haiku-4
AI_MODEL_LIGHT=claude-haiku-4

# ── 받아쓰기(STT): Groq Whisper (OpenAI 호환) ────────────────
GROQ_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3

# ── Supabase ──────────────────────────────────────────────
# Supabase 대시보드 > Project Settings > API 에서 복사. 공개 키(publishable, sb_publishable_...) 또는 옛 anon 키.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 비밀 키(service_role). 가입(/api/auth/signup)이 씀. NEXT_PUBLIC_ 을 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=
