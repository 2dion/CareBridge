        "중풍",
        "고혈압",
        "당뇨",
        "관절염",
        "와상",
        "준와상",
        "자립",
        "기타",
        "기관지절개관",
        "틀니(부분/전체)",
        "비위관(L-tube)",
        "고정소변배출관(유치도뇨관)",
        "방광루",
        "요루(요도샛길)",
        "장루(창자샛길)",
        "기저귀",
        "욕창(부위)",
        "욕창방지 보조도구"
      ],
      "rule": "수급자의 현재 상태를 확인하고 해당 사항에 √표 (유의사항 1)",
      "ai_policy": "기관 등록 정보만 표시. AI가 메모에서 추정하거나 바꾸지 않음"
    },
    {
      "key": "date",
      "label": "월/일",
      "input": "date"
    }
  ],
  "sections": [
    {
      "key": "physical",
      "label": "신체활동지원",
      "writer": "해당 서비스를 제공한 종사자",
      "fields": [
        {
          "key": "hygiene",
          "label": "세면, 구강청결, 머리감기, 몸단장, 옷 갈아입기 도움 등",
          "input": "check"
        },
        {
          "key": "bath",
          "label": "목욕",
          "input": "check_text",
          "rule": "제공 전·후 상태를 확인하고 결과를 괄호에 기록. 예) 이상무, 얼굴창백함, 오한있음 (유의사항 2)"
        },
        {
          "key": "meal_type",
          "label": "식사 종류",
          "input": "choice",
          "options": [
            "일반식",
            "죽",
            "유동식(튜브영양공급식)"
          ],
          "rule": "해당 사항에 √표 (유의사항 3)",
          "textbook_note": "2026 표준교재 p.348 예시 양식은 '유동식(경관식)'으로 표기"
        },
        {
          "key": "meal_intake",
          "label": "식사 섭취량",
          "input": "choice",
          "options": [
            "1",
            "1/2이상",
            "1/2미만"
          ],
          "rule": "해당 사항에 √표 (유의사항 3)",
          "ai_policy": "메모 표현이 선택지 하나로 정해지지 않으면 비우고 needs_check",
          "option_codes": {
            "1": "full",
            "1/2이상": "half_or_more",
            "1/2미만": "under_half"
          },
          "option_codes_status": "확정 (백엔드 담당 10/22)"
        },
        {
          "key": "reposition_2h",
          "label": "체위변경(2시간마다)",
          "input": "check",
          "rule": "2시간마다 제공한 경우에만 √표 (유의사항 4)"
        },
        {
          "key": "toilet_count",
          "label": "화장실이용하기(기저귀 교환)",
          "input": "count",
          "unit": "회",
          "rule": "소변·대변 총 횟수. 기저귀 사용 시 기저귀 교환 횟수 (유의사항 5)"
        },
        {
          "key": "mobility",
          "label": "이동도움 및 신체기능유지·증진",
          "input": "check"
        },
        {
          "key": "outing",
          "label": "산책(외출) 동행",
          "input": "multi_check",
          "options": [
            "산책",
            "외출"
          ],
          "rule": "제공한 경우 √표 (유의사항 6)"
        },
        {
          "key": "notes",
          "label": "특이사항",
          "input": "text",
          "max_chars": null,
          "rule": "상태변화 등이 있을 경우 조치사항 등을 기록. 여백 부족 시 별지 사용 가능 (유의사항 8). 예) 설사를 해서 엉덩이 짓물러 파우더 바름"
        },
        {
          "key": "signer",
          "label": "작성자 성명(서명)",
          "input": "sign"
        }
      ]
    },
